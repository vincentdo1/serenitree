# ---- Server ----
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins for CORS (the frontend).
CORS_ORIGIN=http://localhost:4000

# ---- Database ----
# Left BLANK (the default), the backend uses an in-process PGlite database
# (a WASM build of Postgres) so you can run and test with zero external setup.
# To use the docker-compose Postgres instead, uncomment the line below.
# DATABASE_URL=postgres://serenitree:serenitree@localhost:5432/serenitree
DATABASE_URL=
# Where the PGlite fallback stores its data (only used when DATABASE_URL is blank).
PGLITE_PATH=./.pglite

# ---- Auth ----
# CHANGE THIS in production. Used to sign JWTs.
JWT_SECRET=dev-insecure-secret-change-me
# Token lifetime in seconds (default 7 days).
JWT_TTL_SECONDS=604800

# ---- LLM integration (optional) ----
# Provider: "auto" uses Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if
# OPENAI_API_KEY is set, else a deterministic offline stub. You can also pin it
# to "anthropic", "openai", or "stub" explicitly.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
